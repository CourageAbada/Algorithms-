# Copy to .env (git-ignored). All values below are FAKE placeholders.
TRADING_MODE=SHADOW                 # BACKTEST | REPLAY | SHADOW | DEMO | LIVE
LOG_LEVEL=INFO

# MetaTrader 5 (DEMO account ONLY: Phase 1 refuses REAL/CONTEST accounts)
# If the terminal is already logged in to the demo account you may leave MT5_PASSWORD blank/"change-me"
# and MT5_LOGIN unset: the adapter then attaches to the running terminal. Never commit your real .env.
MT5_LOGIN=00000000
MT5_PASSWORD=change-me
MT5_SERVER=Broker-Demo
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe

DATABASE_URL=postgresql://user:password@localhost:5432/fxscalp
ECON_CALENDAR_API_KEY=change-me
LLM_API_KEY=change-me

# EMERGENCY_FLATTEN authorisation (human-controlled; blank = flattening cannot be authorised)
EMERGENCY_FLATTEN_TOKEN=

# LIVE interlock: ALL of these must be set deliberately by a human. Leave blank in dev.
LIVE_TRADING_ENABLED=false
LIVE_ACKNOWLEDGEMENT=
LIVE_ACKNOWLEDGEMENT_EXPECTED=
